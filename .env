# Container Configuration
CONTAINER_NAME=my-server-name-lamp

# Port Mapping
HTTP_PORT=80
HTTPS_PORT=443
SSH_PORT=2222

# SSH Access
# Set a strong password for root user
ROOT_PASSWORD=your-root-ssh-pass

# MySQL Configuration
MYSQL_ROOT_PASSWORD=your-db-root-pass
MYSQL_DATABASE=mydb
MYSQL_USER=dbuser
MYSQL_PASSWORD=test-user-pass

# PHP Settings (Applied to all PHP versions)
# These can be overridden per version in conf/php/php-X.X.ini
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=300
PHP_UPLOAD_MAX_FILESIZE=128M
PHP_POST_MAX_SIZE=128M

# Tiny file manager
# Initial credentials, to be changed after first login  
# admin/admin@123
